# ⚠️  This file is COMMITTED to git. Never put real secrets here.
# ⚠️  Real values belong in `.env.local` (which is gitignored).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude API — match scoring, suggestions, intro email rationale)
ANTHROPIC_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=connect@alchemy.theupherroom.com

# Google OAuth (Calendar free/busy + event create)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Vercel cron secret (Bearer token sent by Vercel to /api/cron/suggestions)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
